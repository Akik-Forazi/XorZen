# ─── Xorzen runtime artifacts ─────────────────────────────────────────────
# Logs and metrics generated at runtime
logs/
*.log
metrics_*.csv
sppq/

# Expert shard caches (generated at runtime by ShardedExpertFabric)
experts/
*.pt
